# env example — never commit real secrets
DATABASE_URL=postgresql://nawimark:nawimark@localhost:5432/nawimark
AUTH_SECRET=replace-me-with-32-plus-random-chars
# Auth.js trusts the incoming Host header for this single self-hosted origin
# (see trustHost in src/lib/auth.config.ts). Unset here for local dev, but
# in production set AUTH_URL to the real deployed origin (e.g.
# https://nawimark.example.org) — that's what actually closes the
# host-header-injection/open-redirect gap trustHost alone leaves open.
# AUTH_URL=https://your-deployed-origin
# Demo logins are seeded. Labelled mocked. Not RRSL.
DEMO_TESTER_EMAIL=tester@nawimark.local
DEMO_REVIEWER_EMAIL=reviewer@nawimark.local
DEMO_PASSWORD=demo-only-change-me
